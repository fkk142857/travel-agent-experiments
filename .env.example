# 复制本文件为 .env 并填写真实值。.env 已被 .gitignore 忽略，不会进入仓库。
#   cp .env.example .env

# DeepSeek（OpenAI 兼容接口）—— 必填，缺失时服务会拒绝启动
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_MODEL_ID="deepseek-chat"

# 访问口令：发布到公网后，只有知道这个口令的人才能打开应用
# 留空 = 关闭鉴权（本地开发方便）
ACCESS_PASSWORD=""

# 服务端口（可选）：本地默认 8000；部署平台注入 PORT 时优先使用
PORT=8000
